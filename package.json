{
  "name": "sl-bad-boy",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "SL BAD BOY — an original 3D Sri Lankan endless runner for web and Android.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "assets:android": "node scripts/render-mobile-assets.mjs",
    "assets:runners": "node scripts/render-runner-previews.mjs",
    "android:sync": "npm run build && npm run assets:android && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "vite": "8.3.5"
  }
}
